# Copy this file to .env.local and fill in the values. The first three come from Supabase → Project Settings → API Keys.
# Variable names follow the current Supabase "Server-Side Auth for Next.js" guide.

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…; a legacy "anon" key also works). Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…; a legacy "service_role" key also works). Seed script only: it bypasses all security, so never add it to Vercel.
SUPABASE_SECRET_KEY=

# Optional: emailing the admin about each new form (leave all three empty to switch it off).
# Resend API key, from resend.com → API Keys. Server-only: it must never get a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# Who gets the "new safety form" emails. Until you verify a domain in Resend, this must be your Resend account's own email.
ADMIN_NOTIFICATION_EMAIL=

# The app's address, used for the link in the email: http://localhost:3000 locally, the Vercel address when deployed.
NEXT_PUBLIC_APP_URL=
