# Copy this file to .env.local and fill in the values from Supabase → Project Settings → API Keys.
# Variable names follow the current Supabase "Server-Side Auth for Next.js" guide.

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…; a legacy "anon" key also works). Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…; a legacy "service_role" key also works). Seed script only: it bypasses all security, so never add it to Vercel.
SUPABASE_SECRET_KEY=
